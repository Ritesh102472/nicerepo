NODE_ENV=development
PORT=5001

# MongoDB connection string
# For local dev (no Docker): mongodb://localhost:27017/cosmic_watch
# Inside Docker Compose:     mongodb://mongo:27017/cosmic_watch
MONGODB_URI=mongodb://localhost:27017/cosmic_watch

# JWT – generate a strong random value for production
# Example: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_change_this
JWT_EXPIRE=7d

# Google Gemini API – used by /api/hypothetical-hit (optional feature)
# Get a free key at https://aistudio.google.com
GEMINI_API_KEY=your-gemini-api-key

# Google OAuth – used for "Sign in with Google" on the login page
# Create credentials at console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your-google-oauth-client-id

# NASA NeoWs API – DEMO_KEY is heavily rate-limited (use 429 errors as signal).
# Get a free key at https://api.nasa.gov
NASA_API_KEY=DEMO_KEY
NASA_API_BASE_URL=https://api.nasa.gov/neo/rest/v1

# CORS – origin allowed to make requests to this server
# For local dev: http://localhost:8080
# For Docker / production: set to your frontend domain
FRONTEND_URL=http://localhost:8080

# Vite dev-server proxy target (local development without Docker).
# Change this only if your backend runs on a non-default host/port.
# In Docker the nginx config handles proxying – this file is ignored at build time.
# BACKEND_URL=http://localhost:5001

# Socket.IO server URL (optional; defaults to same origin / Vite proxy)
# VITE_SOCKET_URL=http://localhost:5001

# NASA API key for the 3D Solar System component (optional)
# Uses DEMO_KEY if not set – heavily rate-limited.
# Get a free key at https://api.nasa.gov
# VITE_NASA_API_KEY=your_nasa_api_key_here

# Google OAuth Client ID (must match backend GOOGLE_CLIENT_ID)
# VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id
